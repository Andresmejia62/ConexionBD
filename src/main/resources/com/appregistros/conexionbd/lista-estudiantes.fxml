<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.appregistros.conexionbd.controller.EstudianteController">
    <top>
        <HBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
            <children>
                <Button fx:id="btCargar" mnemonicParsing="false" onAction="#CargarEstudiantes" text="Cargar" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tblEstudiante" prefHeight="400.0" prefWidth="900.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="Id" />
                <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
                <TableColumn fx:id="colCorreo" prefWidth="180.0" text="Correo" />
                <TableColumn fx:id="colCarrera" prefWidth="150.0" text="Carrera" />
                <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
                <TableColumn fx:id="colEdad" prefWidth="60.0" text="Edad" />
                <TableColumn fx:id="colFechaIngreso" prefWidth="110.0" text="Fecha Ingreso" />
                <TableColumn fx:id="colPromedio" prefWidth="90.0" text="Promedio" />
            </columns>
        </TableView>
    </center>
</BorderPane>