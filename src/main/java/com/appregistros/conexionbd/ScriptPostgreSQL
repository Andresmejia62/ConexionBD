alter table estudiante
    add column carrera varchar(100),
    add column telefono varchar(20),
    add column edad integer,
    add column fecha_ingreso date,
    add column promedio decimal(5,2);

delete from estudiante
where carrera is null
   or telefono is null
   or edad is null
   or fecha_ingreso is null
   or promedio is null;

